/dts-v1/;

/ {
    compatible = "VirtualSoC, V1.0";
    #address-cells = <1>;
    #size-cells = <1>;

    /* 在这里添加你的节点 */
    
    /* 1. I2C控制器及温度传感器 */
    i2c0: i2c@400A0000 {
        compatible = "virtual,i2c-v1";
        reg = <0x400A0000 0x1000>;
        #address-cells = <1>;
        #size-cells = <0>;
        clock-frequency = <100000>;
        interrupts = <33 1>;

        /* 温度传感器 */
        temp-sensor@48 {
            compatible = "ti,tmp75";
            reg = <0x48>;
            power-gpios = <&gpio 17 1>;
        };
    };
    
    /* 2. SPI控制器及Flash */
    
    /* 3. GPIO控制器及LED、按键 */
    
    /* 4. 串口控制器 */
};

/dts-v1/;

/ {
    compatible = "my-virtual-board";
    #address-cells = <1>;
    #size-cells = <1>;

    /* I2C控制器 */
    i2c0: i2c@400A0000 {
        compatible = "virtual,i2c-controller";
        reg = <0x400A0000 0x1000>;
        #address-cells = <1>;
        #size-cells = <0>;
        clock-frequency = <100000>;

        /* 温度传感器 */
        temp-sensor@48 {
            compatible = "ti,tmp75";
            reg = <0x48>;
        };
    };

    /* SPI控制器 */
    spi0: spi@400B0000 {
        compatible = "virtual,spi-controller";
        reg = <0x400B0000 0x1000>;
        #address-cells = <1>;
        #size-cells = <0>;
        cs-gpios = <&gpio 8 0>;

        /* SPI Flash */
        flash@0 {
            compatible = "winbond,w25q128";
            reg = <0>;
            spi-max-frequency = <50000000>;
        };
    };

    /* GPIO LED */
    leds {
        compatible = "gpio-leds";
        led0 {
            label = "system-led";
            gpios = <&gpio 23 0>;
            default-state = "off";
        };
    };
};
1. 虚拟硬件场景设定
假设我们有一个虚拟开发板，包含以下组件：

1个I2C控制器（i2c0）

1个SPI控制器（spi0）

1个GPIO控制器

需要添加的设备：

I2C温度传感器（地址0x48，型号tmp75）

SPI Flash（型号w25q128）

LED灯（连接在GPIO23上）